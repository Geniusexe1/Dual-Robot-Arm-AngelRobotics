<?xml version="1.0" ?>
<robot name="URDF" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo>
  <plugin name="control" filename="libgazebo_ros_control.so">
    <robotNamespace>/URDF</robotNamespace>
  </plugin>
</gazebo>

<!-- Gazebo ignores URDF <mimic>; these plugins enforce the 4-bar couplings (values written by the generator to match URDF.xacro). -->
<xacro:macro name="mimic" params="joint mimic multiplier offset">
  <gazebo>
    <plugin name="${mimic}_mimic" filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so">
      <joint>${joint}</joint>
      <mimicJoint>${mimic}</mimicJoint>
      <multiplier>${multiplier}</multiplier>
      <offset>${offset}</offset>
    </plugin>
  </gazebo>
</xacro:macro>
<xacro:mimic joint="J4" mimic="J4_bar" multiplier="-1.255004" offset="0.000000"/>
<xacro:mimic joint="J5" mimic="J5_bar" multiplier="-1.372780" offset="0.000000"/>
<xacro:mimic joint="J4" mimic="J4_crank" multiplier="1.361386" offset="-0.545924"/>
<xacro:mimic joint="J5" mimic="J5_crank" multiplier="1.306152" offset="0.294257"/>

<!-- ros_control only publishes J1-J5; publish the passive joints so robot_state_publisher has the full tree. -->
<gazebo>
  <plugin name="passive_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
    <robotNamespace>/URDF</robotNamespace>
    <jointName>J4_crank, J4_bar, J5_crank, J5_bar</jointName>
    <updateRate>50</updateRate>
  </plugin>
</gazebo>
<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="carbontube_elbow_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

